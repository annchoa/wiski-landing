{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Assistant|Braah One|B612))/i]",
        "message": "Font not provided by the design system. Available: Assistant, Braah One, B612."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|initials|type|size|shape|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: className, style, initials, type, size, shape."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:initial|image)$/]",
        "message": "<Avatar> type must be one of 'initial' | 'image'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|sm|md)$/]",
        "message": "<Avatar> size must be one of 'lg' | 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|square)$/]",
        "message": "<Avatar> shape must be one of 'circle' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|title|description|icon1|key|ref|className|style|children)$/]",
        "message": "<AvatarBlock> doesn't accept that prop. Declared props: className, style, title, description, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardGridReviews'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|platform|key|ref|className|style|children)$/]",
        "message": "<CardGridReviews> doesn't accept that prop. Declared props: className, style, platform."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardGridReviews'] > JSXAttribute[name.name='platform'] > Literal[value!=/^(?:desktop|mobile)$/]",
        "message": "<CardGridReviews> platform must be one of 'desktop' | 'mobile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavigationPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|label|state|key|ref|className|style|children)$/]",
        "message": "<NavigationPill> doesn't accept that prop. Declared props: className, style, label, state."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavigationPill'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|active|hover)$/]",
        "message": "<NavigationPill> state must be one of 'default' | 'active' | 'hover'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavigationPillList'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|link1|link6|slot|link7|slot2|link3|link2|link4|link5|direction|icon1|icon2|icon3|icon4|key|ref|className|style|children)$/]",
        "message": "<NavigationPillList> doesn't accept that prop. Declared props: className, style, link1, link6, slot, link7, slot2, link3, link2, link4, link5, direction, icon1, icon2, icon3, icon4."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavigationPillList'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:row|column)$/]",
        "message": "<NavigationPillList> direction must be one of 'row' | 'column'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductInfoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|title|price|body|showDescription|image|icon1|key|ref|className|style|children)$/]",
        "message": "<ProductInfoCard> doesn't accept that prop. Declared props: className, style, title, price, body, showDescription, image, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReviewCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|icon1|icon2|icon3|icon4|key|ref|className|style|children)$/]",
        "message": "<ReviewCard> doesn't accept that prop. Declared props: className, style, icon1, icon2, icon3, icon4."
      },
      {
        "selector": "JSXOpeningElement[name.name='Star'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|key|ref|className|style|children)$/]",
        "message": "<Star> doesn't accept that prop. Declared props: className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Text'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text|key|ref|className|style|children)$/]",
        "message": "<Text> doesn't accept that prop. Declared props: className, style, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text|key|ref|className|style|children)$/]",
        "message": "<TextHeading> doesn't accept that prop. Declared props: className, style, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextSmall'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text|key|ref|className|style|children)$/]",
        "message": "<TextSmall> doesn't accept that prop. Declared props: className, style, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextStrong'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text|key|ref|className|style|children)$/]",
        "message": "<TextStrong> doesn't accept that prop. Declared props: className, style, text."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
